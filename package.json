{
  "name": "synth-motion",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "SYNTH//MOTION \u2014 play a synthesizer with your hands. Webcam hand tracking, a Web Audio music engine, reactive 3D visuals and a TouchDesigner OSC bridge.",
